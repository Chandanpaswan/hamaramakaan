# Copy to .env and fill in. Never commit .env or real credentials.

# --- Core ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# development | production  (manage.py defaults to development; wsgi/asgi default to production)
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set true behind Nginx so rate limits see the real client IP.
USE_X_FORWARDED_FOR=false

# --- Database -----------------------------------------------------------
# sqlite (local) | postgres (staging/production)
DB_ENGINE=sqlite
DB_NAME=hamara_makaan
DB_USER=hamara_makaan
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Cache (production: Redis recommended; otherwise a DB cache table is used)
REDIS_URL=

# --- Email --------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@hamaramakaan.com
# Comma-separated staff inboxes that receive new-lead alerts
LEAD_NOTIFICATION_EMAILS=

# --- Paths (change these to non-obvious values in production) ----------
DASHBOARD_PATH=manage/
DJANGO_ADMIN_PATH=hm-system-admin/
MEDIA_ROOT=

# --- Limits -------------------------------------------------------------
MAX_IMAGE_UPLOAD_MB=5
MAX_IMAGES_PER_SUBMISSION=10
FORM_RATE_LIMIT=5
FORM_RATE_WINDOW=600
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=900

# --- HTTPS (production) -------------------------------------------------
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
LOG_LEVEL=INFO
